# =============================================
# ClawBridge Configuration
# =============================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env

# ----- BYOK: LLM Provider Keys -----
# At least one is required. Your keys stay local -- never logged, never transmitted.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ----- Default LLM Model -----
# Options: claude-sonnet-4-20250514, gpt-4o, gpt-4o-mini, claude-3-5-haiku-20241022
DEFAULT_MODEL=claude-sonnet-4-20250514

# ----- Server Settings -----
CLAWBRIDGE_HOST=127.0.0.1
CLAWBRIDGE_PORT=8765

# ----- Engine Configuration -----
# Which engines to enable: browser_use, openclaw, or both
ENABLED_ENGINES=browser_use,openclaw

# Path to OpenClaw installation (auto-detected if on PATH)
OPENCLAW_PATH=

# ----- Browser Settings -----
# Run browser in headless mode (true) or visible (false)
BROWSER_HEADLESS=true

# ----- Policy Settings -----
# Action policy mode: "guarded" (prompt for sensitive), "permissive" (auto-run all), "strict" (prompt for everything)
POLICY_MODE=guarded

# Max concurrent tasks
MAX_CONCURRENT_TASKS=3

# Max browse actions per task
MAX_ACTIONS_PER_TASK=50

# ----- Telemetry -----
# Local log retention in hours
LOG_RETENTION_HOURS=72

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
