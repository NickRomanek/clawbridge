# =============================================
# ClawBridge Configuration
# =============================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env

# ----- BYOK: LLM Provider Keys -----
# At least one is required. Your keys stay local -- never logged, never transmitted.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# ----- Default LLM Model -----
# Used by browser-use engine. Options: gpt-4o, gpt-4o-mini, claude-sonnet-4-20250514
DEFAULT_MODEL=openai/gpt-4o

# ----- Server Settings -----
CLAWBRIDGE_HOST=127.0.0.1
CLAWBRIDGE_PORT=8765

# ----- Engine Configuration -----
# Which engines to enable (comma-separated): browser_use, computer_use, openclaw
ENABLED_ENGINES=browser_use,computer_use

# Path to OpenClaw installation (auto-detected if on PATH)
OPENCLAW_PATH=

# ----- Computer-Use Settings -----
# Model for desktop automation (must support tool use)
COMPUTER_USE_MODEL=anthropic/claude-sonnet-4-20250514

# Max screenshot dimensions (smaller = better coordinate accuracy)
COMPUTER_USE_MAX_SCREEN_WIDTH=1920
COMPUTER_USE_MAX_SCREEN_HEIGHT=1080

# Delay between actions in milliseconds
COMPUTER_USE_ACTION_DELAY_MS=500

# ----- Browser Settings -----
# Run browser in headless mode (true) or visible (false)
BROWSER_HEADLESS=true

# Browser connection mode: default | cdp | user_data_dir
#   default       = fresh Chromium instance (no persistent logins)
#   cdp           = connect to existing Chrome via DevTools Protocol
#   user_data_dir = persistent Chrome profile with stored logins
BROWSER_MODE=default

# CDP endpoint (when BROWSER_MODE=cdp or after Launch Chrome Session)
BROWSER_CDP_URL=http://localhost:9222

# Chrome profile directory (when BROWSER_MODE=user_data_dir)
BROWSER_USER_DATA_DIR=

# ----- Policy Settings -----
# Action policy mode:
#   guarded    = auto-run safe reads, prompt for sensitive/high-risk
#   permissive = auto-run everything (local trust mode)
#   strict     = prompt for everything except safe reads
POLICY_MODE=guarded

# Max concurrent tasks
MAX_CONCURRENT_TASKS=3

# Max actions per task before stopping
MAX_ACTIONS_PER_TASK=50

# ----- Telemetry -----
# Local log retention in hours
LOG_RETENTION_HOURS=72

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ----- Remote Bridge (Beta) -----
# Connect this machine to a remote ClawBridge orchestration service
REMOTE_BRIDGE_URL=
REMOTE_AUTH_TOKEN=
