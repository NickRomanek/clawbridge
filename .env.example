# =============================================
# ClawBridge Configuration
# =============================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env

# ----- BYOK: LLM Provider Keys -----
# At least one is required. Your keys stay local -- never logged, never transmitted.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# ----- Default LLM Model -----
# Used by browser-use engine. Examples: gpt-4o, gpt-4o-mini, claude-sonnet-4
DEFAULT_MODEL=gpt-4o

# ----- Server Settings -----
CLAWBRIDGE_HOST=127.0.0.1
CLAWBRIDGE_PORT=8765

# ----- Engine Configuration -----
# Which engines to enable (comma-separated): browser_use, computer_use, openclaw
ENABLED_ENGINES=browser_use,computer_use,openclaw

# ----- OpenClaw Settings -----
# OpenClaw gateway port (auto-started when openclaw engine enabled)
OPENCLAW_GATEWAY_PORT=18789

# Optional: bearer token for authenticating with OpenClaw gateway
OPENCLAW_API_KEY=

# Override model for OpenClaw (e.g. openrouter/anthropic/claude-sonnet-4)
# Leave empty to use gateway's configured default model
OPENCLAW_MODEL=

# ----- Computer-Use Settings -----
# Model for desktop automation (must support tool use)
# If ANTHROPIC_API_KEY is set, uses native Anthropic API (recommended)
# If only OPENROUTER_API_KEY is set, uses OpenRouter's Anthropic compatibility layer
COMPUTER_USE_MODEL=anthropic/claude-sonnet-4

# Max screenshot dimensions (smaller = better coordinate accuracy)
COMPUTER_USE_MAX_SCREEN_WIDTH=1920
COMPUTER_USE_MAX_SCREEN_HEIGHT=1080

# Delay between actions in milliseconds
COMPUTER_USE_ACTION_DELAY_MS=500

# ----- Browser Settings -----
# Run browser in headless mode (true) or visible (false)
BROWSER_HEADLESS=true

# Browser connection mode: default | cdp | user_data_dir
#   default       = fresh Chromium instance (no persistent logins)
#   cdp           = connect to existing Chrome via DevTools Protocol
#   user_data_dir = persistent Chrome profile with stored logins
BROWSER_MODE=default

# CDP endpoint (when BROWSER_MODE=cdp or after Launch Chrome Session)
BROWSER_CDP_URL=http://localhost:9222

# Chrome profile directory (when BROWSER_MODE=user_data_dir)
BROWSER_USER_DATA_DIR=

# ----- Safety & Policy Settings -----
# Policy mode: guarded (default), permissive, strict
#   guarded    = flags credentials/PII with warnings but doesn't block tasks
#   permissive = auto-run everything, no blocking
#   strict     = blocks tasks containing credentials in the prompt
POLICY_MODE=guarded

# Automation mode: supervised (default) or autonomous
#   supervised = pauses for user approval before high-risk actions (purchases, form submissions)
#   autonomous = runs without interruption (monitor the live view!)
AUTOMATION_MODE=supervised

# ----- Dashboard Settings -----
# Optional: set a token to require authentication for dashboard access
# Leave empty to disable auth (dashboard is open to anyone on localhost)
DASHBOARD_TOKEN=

# ----- Task Settings -----
# Max concurrent tasks
MAX_CONCURRENT_TASKS=3

# Max actions per task before stopping
MAX_ACTIONS_PER_TASK=50

# Auto-retry failed tasks (0 = disabled, 2 = default)
MAX_TASK_RETRIES=2

# Base delay in seconds for retry exponential backoff (2s -> 4s -> 8s)
RETRY_BASE_DELAY=2.0

# ----- Storage -----
# SQLite database path for task history and audit logs
CLAWBRIDGE_DB=clawbridge.db

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ----- Remote Bridge (Beta) -----
# Connect this machine to a remote ClawBridge orchestration service
REMOTE_BRIDGE_URL=
REMOTE_AUTH_TOKEN=

# ----- License / Activation -----
# Activation code from purchase (leave empty for BYOK mode)
CLAWBRIDGE_ACTIVATION_CODE=
# License tier (auto-set during activation): starter | byok
LICENSE_TIER=
# Activation backend URL
# Production: https://api.clawbridge.ai
# Local testing: http://localhost:8787
ACTIVATION_BACKEND_URL=https://api.clawbridge.ai
