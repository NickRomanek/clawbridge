---
import Base from '../layouts/Base.astro';

const faqs = [
  {
    question: "What is ClawBridge?",
    answer: "ClawBridge is a free, open-source AI agent that automates your browser and desktop applications using plain English commands. It runs locally on your Windows or Mac with full privacy -- your data never leaves your machine except to the LLM API you choose."
  },
  {
    question: "Is ClawBridge free?",
    answer: "Yes. ClawBridge is open source under the Apache 2.0 license and free to download for Windows and macOS. You can bring your own API keys (BYOK) from Anthropic, OpenAI, or OpenRouter at no additional cost, or purchase a starter pack with $5 in pre-loaded credits for $9.99."
  },
  {
    question: "What can ClawBridge automate?",
    answer: "ClawBridge can automate browser tasks (web scraping, form filling, data extraction), desktop applications (Excel, SAP, legacy software), workflow recording and replay, scheduled tasks, cross-app integrations, QA testing, and more -- all controlled through natural language."
  },
  {
    question: "How does ClawBridge work?",
    answer: "You describe what you want done in plain English through a chat-style dashboard. ClawBridge automatically routes your task to the best AI engine: browser-use for web automation, computer-use for desktop apps, or OpenClaw for conversational AI. It can also record your manual workflows and replay them with AI-powered adaptation."
  },
  {
    question: "Is my data private with ClawBridge?",
    answer: "Yes. ClawBridge runs entirely on your local machine. There are no cloud servers, no telemetry, and no data collection. The only external communication is with the LLM API provider you choose (Anthropic, OpenAI, or OpenRouter), and you control those keys."
  },
  {
    question: "What platforms does ClawBridge support?",
    answer: "ClawBridge supports Windows 10/11 and macOS (Apple Silicon and Intel). Download the Windows installer or macOS DMG from the download page. The dashboard runs in any modern browser at localhost:8765."
  },
];

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "ClawBridge",
  "url": "https://clawbridge.ai",
  "logo": "https://clawbridge.ai/logo.png",
  "description": "Open-source AI desktop and browser automation agent.",
  "sameAs": [
    "https://github.com/NickRomanek/clawbridge",
    "https://discord.gg/7QeQ3WsZ"
  ]
};

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "ClawBridge",
  "url": "https://clawbridge.ai",
  "downloadUrl": "https://clawbridge.ai/download",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "Windows 10, Windows 11, macOS",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": "AI-powered desktop and browser automation agent. Automate web browsing, form filling, data extraction, and desktop app control using plain English commands.",
  "featureList": [
    "Browser automation with Playwright",
    "Desktop application control via accessibility APIs",
    "Workflow recording and AI-powered replay",
    "Natural language task descriptions",
    "BYOK - Bring your own API keys",
    "Local-first execution with full privacy",
    "Smart auto-routing across three AI engines",
    "Scheduled task automation"
  ],
  "screenshot": "https://clawbridge.ai/og-image.png",
  "softwareVersion": "0.5.6",
  "license": "https://www.apache.org/licenses/LICENSE-2.0"
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "ClawBridge",
  "alternateName": ["ClawBridge AI", "ClawBridge Automation"],
  "url": "https://clawbridge.ai",
  "description": "Free, open-source AI agent for browser and desktop automation. Control your computer with plain English."
};
---

<Base title="ClawBridge - AI Desktop & Browser Automation Agent | Free & Open Source">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  </Fragment>
  <!-- Hero Section -->
  <section class="relative min-h-[90vh] flex items-center justify-center overflow-hidden">
    <!-- Background effects -->
    <div class="absolute inset-0 grid-pattern opacity-50"></div>
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-primary/20 rounded-full blur-[128px] animate-pulse"></div>
    <div class="absolute bottom-1/4 right-1/4 w-80 h-80 bg-blue-500/20 rounded-full blur-[100px] animate-pulse" style="animation-delay: 1s;"></div>

    <div class="relative z-10 max-w-5xl mx-auto px-6 text-center">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/5 border border-white/10 backdrop-blur-sm mb-8 animate-float">
        <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
        <span class="text-sm text-gray-300">Record it once. Replay it forever.</span>
      </div>

      <!-- Main headline -->
      <h1 class="text-5xl md:text-7xl font-extrabold mb-6 leading-tight">
        <span class="gradient-text">Your Computer,</span>
        <br>
        <span class="gradient-text-brand">on Autopilot</span>
      </h1>

      <p class="text-xl md:text-2xl text-gray-400 mb-10 max-w-2xl mx-auto leading-relaxed">
        Tell it what to do in plain English. It controls browsers, apps, and
        <span class="text-white font-medium">everything in between</span>.
      </p>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
        <a href="/pricing/" class="btn-primary text-lg px-8 py-4 gap-2">
          <span>Get Started</span>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
          </svg>
        </a>
        <a href="/download/" class="btn-secondary text-lg px-8 py-4 gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
          </svg>
          <span>Download Free</span>
        </a>
      </div>

      <!-- Trust indicators -->
      <div class="flex flex-wrap items-center justify-center gap-6 text-sm text-gray-500">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-green-500" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
          </svg>
          <span>Local-First</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-green-500" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
          </svg>
          <span>Your Data Stays Private</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-green-500" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
          </svg>
          <span>BYOK Supported</span>
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
      <svg class="w-6 h-6 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
      </svg>
    </div>
  </section>

  <!-- Demo/Preview Section -->
  <section class="py-24 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="relative rounded-2xl border border-white/10 bg-white/[0.02] p-2 glow-primary">
        <!-- Browser chrome mockup -->
        <div class="flex items-center gap-2 px-4 py-3 border-b border-white/10">
          <div class="flex gap-1.5">
            <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
            <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
          </div>
          <div class="flex-1 flex justify-center">
            <div class="px-4 py-1.5 rounded-lg bg-white/5 text-sm text-gray-400 font-mono">
              localhost:8765
            </div>
          </div>
        </div>
        <!-- Screenshot placeholder -->
        <div class="aspect-video bg-gradient-to-br from-dark-800 to-dark-900 rounded-lg flex items-center justify-center">
          <div class="text-center">
            <div class="w-20 h-20 mx-auto mb-4 rounded-2xl bg-gradient-to-br from-primary/20 to-blue-500/20 flex items-center justify-center">
              <svg class="w-10 h-10 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <p class="text-gray-500 text-sm">Dashboard Preview</p>
            <p class="text-gray-600 text-xs mt-1">Screenshot coming soon</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="py-24 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <span class="section-label">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg>
          Powerful Engines
        </span>
        <h2 class="text-4xl md:text-5xl font-bold gradient-text mb-4">Three Ways to Automate</h2>
        <p class="text-xl text-gray-400 max-w-2xl mx-auto">Choose the right tool for the job. ClawBridge automatically picks the best engine for your task.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        <!-- Browser Automation -->
        <div class="card-glow group">
          <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-blue-500/20 to-cyan-500/20 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-7 h-7 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-3">Browser Automation</h3>
          <p class="text-gray-400 mb-4 leading-relaxed">Navigate websites, fill forms, extract data, and automate web workflows with headless browser control.</p>
          <div class="flex flex-wrap gap-2">
            <span class="px-2.5 py-1 rounded-lg bg-blue-500/10 text-blue-400 text-xs font-medium">Web Scraping</span>
            <span class="px-2.5 py-1 rounded-lg bg-blue-500/10 text-blue-400 text-xs font-medium">Form Filling</span>
            <span class="px-2.5 py-1 rounded-lg bg-blue-500/10 text-blue-400 text-xs font-medium">Testing</span>
          </div>
        </div>

        <!-- Desktop Control -->
        <div class="card-glow group">
          <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-purple-500/20 to-pink-500/20 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-7 h-7 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-3">Desktop Control</h3>
          <p class="text-gray-400 mb-4 leading-relaxed">Control any desktop application with AI-powered mouse clicks, keyboard input, and screenshot analysis.</p>
          <div class="flex flex-wrap gap-2">
            <span class="px-2.5 py-1 rounded-lg bg-purple-500/10 text-purple-400 text-xs font-medium">Any App</span>
            <span class="px-2.5 py-1 rounded-lg bg-purple-500/10 text-purple-400 text-xs font-medium">Visual AI</span>
            <span class="px-2.5 py-1 rounded-lg bg-purple-500/10 text-purple-400 text-xs font-medium">Accessibility</span>
          </div>
        </div>

        <!-- Workflow Recording -->
        <div class="card-glow group">
          <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-green-500/20 to-emerald-500/20 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-7 h-7 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-3">Workflow Recording</h3>
          <p class="text-gray-400 mb-4 leading-relaxed">Record your workflow once, then let AI replay it -- adapting to changes on the fly. No scripting needed.</p>
          <div class="flex flex-wrap gap-2">
            <span class="px-2.5 py-1 rounded-lg bg-green-500/10 text-green-400 text-xs font-medium">Record</span>
            <span class="px-2.5 py-1 rounded-lg bg-green-500/10 text-green-400 text-xs font-medium">Replay</span>
            <span class="px-2.5 py-1 rounded-lg bg-green-500/10 text-green-400 text-xs font-medium">Adaptive</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="py-24 px-6 relative">
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-primary/5 to-transparent"></div>

    <div class="relative max-w-4xl mx-auto">
      <div class="text-center mb-16">
        <span class="section-label">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
          Quick Start
        </span>
        <h2 class="text-4xl md:text-5xl font-bold gradient-text mb-4">Up and Running in Minutes</h2>
        <p class="text-xl text-gray-400">No complex setup. Just download, activate, and start automating.</p>
      </div>

      <div class="space-y-6">
        <div class="flex gap-6 items-start p-6 rounded-2xl bg-white/[0.02] border border-white/[0.08] hover:bg-white/[0.04] transition-colors">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-primary to-blue-500 flex items-center justify-center flex-shrink-0 font-bold text-lg shadow-lg shadow-primary/25">1</div>
          <div>
            <h3 class="text-xl font-semibold mb-2">Download & Install</h3>
            <p class="text-gray-400">Get the Windows installer. One click, everything included — no Python setup needed.</p>
          </div>
        </div>

        <div class="flex gap-6 items-start p-6 rounded-2xl bg-white/[0.02] border border-white/[0.08] hover:bg-white/[0.04] transition-colors">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-primary to-blue-500 flex items-center justify-center flex-shrink-0 font-bold text-lg shadow-lg shadow-primary/25">2</div>
          <div>
            <h3 class="text-xl font-semibold mb-2">Activate or BYOK</h3>
            <p class="text-gray-400">Enter your activation code for instant setup, or bring your own API keys from Anthropic, OpenAI, or OpenRouter.</p>
          </div>
        </div>

        <div class="flex gap-6 items-start p-6 rounded-2xl bg-white/[0.02] border border-white/[0.08] hover:bg-white/[0.04] transition-colors">
          <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-primary to-blue-500 flex items-center justify-center flex-shrink-0 font-bold text-lg shadow-lg shadow-primary/25">3</div>
          <div>
            <h3 class="text-xl font-semibold mb-2">Start Automating</h3>
            <p class="text-gray-400">Open the dashboard and tell ClawBridge what to do. "Go to Amazon and find the best wireless headphones under $100."</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Use Cases -->
  <section class="py-24 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <span class="section-label">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
          </svg>
          Use Cases
        </span>
        <h2 class="text-4xl md:text-5xl font-bold gradient-text mb-4">What Will You Automate?</h2>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
        {[
          { icon: "🔍", title: "Research & Scraping", desc: "Gather data from multiple sites automatically" },
          { icon: "📝", title: "Form Automation", desc: "Fill repetitive forms in seconds" },
          { icon: "📊", title: "Report Generation", desc: "Extract data and create reports" },
          { icon: "🧪", title: "QA Testing", desc: "Test web apps with AI-powered flows" },
          { icon: "📧", title: "Email Workflows", desc: "Process emails and attachments" },
          { icon: "🖥️", title: "Desktop Tasks", desc: "Control any app like a human would" },
          { icon: "🔁", title: "Workflow Recording", desc: "Record once, replay forever -- AI adapts to changes" },
          { icon: "📅", title: "Scheduled Tasks", desc: "Set it and forget it -- runs on your schedule" },
          { icon: "🔗", title: "App Integrations", desc: "Bridge apps that were never meant to talk" },
        ].map(item => (
          <div class="p-5 rounded-xl bg-white/[0.02] border border-white/[0.08] hover:bg-white/[0.05] hover:border-white/[0.15] transition-all group cursor-default">
            <div class="text-2xl mb-3">{item.icon}</div>
            <h3 class="font-semibold mb-1 group-hover:text-primary transition-colors">{item.title}</h3>
            <p class="text-sm text-gray-500">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-24 px-6">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-16">
        <span class="section-label">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          FAQ
        </span>
        <h2 class="text-4xl md:text-5xl font-bold gradient-text mb-4">Frequently Asked Questions</h2>
      </div>

      <div class="space-y-4">
        {faqs.map(faq => (
          <details class="group rounded-2xl border border-white/[0.08] bg-white/[0.02] overflow-hidden">
            <summary class="flex items-center justify-between gap-4 p-6 cursor-pointer text-lg font-semibold hover:bg-white/[0.04] transition-colors list-none [&::-webkit-details-marker]:hidden">
              <span>{faq.question}</span>
              <svg class="w-5 h-5 text-gray-500 flex-shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </summary>
            <div class="px-6 pb-6 text-gray-400 leading-relaxed">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-32 px-6 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-t from-primary/10 via-transparent to-transparent"></div>
    <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-primary/20 rounded-full blur-[150px]"></div>

    <div class="relative max-w-3xl mx-auto text-center">
      <h2 class="text-4xl md:text-5xl font-bold gradient-text mb-6">Ready to Automate?</h2>
      <p class="text-xl text-gray-400 mb-10">Open source, free to start. Bring your own API keys or get $5 in credits for $9.99.</p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/pricing/" class="btn-primary text-lg px-10 py-4">
          View Pricing
        </a>
        <a href="/docs/" class="btn-secondary text-lg px-10 py-4">
          Read the Docs
        </a>
      </div>
    </div>
  </section>
</Base>
