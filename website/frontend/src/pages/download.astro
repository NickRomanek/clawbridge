---
import Base from '../layouts/Base.astro';
const downloadUrl = import.meta.env.PUBLIC_DOWNLOAD_URL || "https://github.com/NickRomanek/clawbridge/releases/latest/download/ClawBridge-Setup.exe";
---

<Base title="Download - ClawBridge">
  <section class="py-24 px-6">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-16">
        <span class="section-label">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
          </svg>
          Download
        </span>
        <h1 class="text-4xl md:text-5xl font-bold gradient-text mb-4">Get ClawBridge</h1>
        <p class="text-xl text-gray-400">Up and running in under a minute</p>
      </div>

      <!-- Download Card -->
      <div class="relative group max-w-xl mx-auto mb-12">
        <div class="absolute -inset-px bg-gradient-to-r from-primary via-blue-500 to-cyan-500 rounded-3xl opacity-30 blur group-hover:opacity-50 transition-opacity"></div>
        <div class="relative bg-dark-900 rounded-3xl p-10 text-center border border-white/10">
          <div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-primary/20 to-blue-500/20 flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform">
            <svg class="w-10 h-10 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </div>
          <h2 class="text-2xl font-bold mb-2">ClawBridge for Windows</h2>
          <p class="text-gray-400 mb-6">Version 0.3.7 &bull; Windows 10/11 (64-bit)</p>
          <a href={downloadUrl} class="btn-primary text-lg px-10 py-4 mb-4 inline-flex gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
            </svg>
            Download Installer
          </a>
          <p class="text-sm text-gray-500">~295 MB &bull; Includes everything needed</p>
        </div>
      </div>

      <!-- Activation Code Section (shown when coming from purchase) -->
      <div id="activation-section" class="max-w-xl mx-auto mb-12 hidden">
        <div class="p-8 rounded-2xl bg-gradient-to-br from-green-500/10 to-emerald-500/10 border border-green-500/20 text-center">
          <div class="w-12 h-12 rounded-full bg-green-500/20 flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-2">Your Activation Code</h3>
          <div class="bg-dark-900/50 rounded-xl p-4 mb-4">
            <code id="activation-code" class="text-2xl font-mono tracking-wider text-primary">CB-XXXX-XXXX-XXXX</code>
          </div>
          <p class="text-sm text-gray-400">Enter this code in ClawBridge after installation to activate.</p>
        </div>
      </div>

      <!-- Quick Start Steps -->
      <div class="max-w-xl mx-auto">
        <h3 class="text-xl font-semibold mb-6 text-center">Quick Start</h3>
        <div class="space-y-4">
          <div class="flex gap-4 items-start p-4 rounded-xl bg-white/[0.02] border border-white/[0.08]">
            <div class="w-8 h-8 rounded-lg bg-primary/20 flex items-center justify-center flex-shrink-0 text-primary font-bold text-sm">1</div>
            <div>
              <h4 class="font-medium mb-1">Run the Installer</h4>
              <p class="text-sm text-gray-400">Double-click ClawBridge-Setup.exe and follow the wizard</p>
            </div>
          </div>
          <div class="flex gap-4 items-start p-4 rounded-xl bg-white/[0.02] border border-white/[0.08]">
            <div class="w-8 h-8 rounded-lg bg-primary/20 flex items-center justify-center flex-shrink-0 text-primary font-bold text-sm">2</div>
            <div>
              <h4 class="font-medium mb-1">Activate or Enter API Keys</h4>
              <p class="text-sm text-gray-400">Use your activation code from purchase, or enter your own keys</p>
            </div>
          </div>
          <div class="flex gap-4 items-start p-4 rounded-xl bg-white/[0.02] border border-white/[0.08]">
            <div class="w-8 h-8 rounded-lg bg-primary/20 flex items-center justify-center flex-shrink-0 text-primary font-bold text-sm">3</div>
            <div>
              <h4 class="font-medium mb-1">Open Dashboard</h4>
              <p class="text-sm text-gray-400">Visit <code class="text-primary bg-primary/10 px-1.5 py-0.5 rounded">localhost:8765</code> in your browser</p>
            </div>
          </div>
          <div class="flex gap-4 items-start p-4 rounded-xl bg-white/[0.02] border border-white/[0.08]">
            <div class="w-8 h-8 rounded-lg bg-primary/20 flex items-center justify-center flex-shrink-0 text-primary font-bold text-sm">4</div>
            <div>
              <h4 class="font-medium mb-1">Start Automating!</h4>
              <p class="text-sm text-gray-400">Tell ClawBridge what to do in natural language</p>
            </div>
          </div>
        </div>
      </div>

      <!-- BYOK Guide Link -->
      <div class="text-center mt-12">
        <p class="text-gray-500 mb-2">Using your own API keys?</p>
        <a href="/docs/byok" class="text-primary hover:text-blue-400 transition-colors inline-flex items-center gap-1">
          Read the BYOK Setup Guide
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
          </svg>
        </a>
      </div>
    </div>
  </section>
</Base>

<script>
  // Show activation code if present in URL
  const params = new URLSearchParams(window.location.search);
  const code = params.get('code');
  if (code) {
    const section = document.getElementById('activation-section');
    const codeEl = document.getElementById('activation-code');
    if (section && codeEl) {
      section.classList.remove('hidden');
      codeEl.textContent = code;
    }
  }
</script>
